<Application xmlns="https://github.com/avaloniaui"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:local="using:NightlyLauncher"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NightlyLauncher.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!--
                Layout values for all pages (4-px grid):
                  4  Spacing between cards / list items
                  8  Spacing between heading and content; controls in a single row
                  12  Spacing between icon and text
                  16  Vertical page margin
                  24  Horizontal page margin (recommended for NavigationView content)
            -->

            <Thickness x:Key="PageHeaderMargin">24 16 24 0</Thickness>
            <Thickness x:Key="PageContentMargin">24 0</Thickness>
            <Thickness x:Key="PageScrollPadding">24 0 24 16</Thickness>
            <x:Double x:Key="PageRowSpacing">8</x:Double>
            <x:Double x:Key="ListItemIconSize">24</x:Double>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <styling:FluentAvaloniaTheme />

        <Style Selector="Button.icon-only">
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="Button.icon-only > ic|SymbolIcon">
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Application.Styles>
</Application>
