<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:loc="clr-namespace:NightlyLauncher.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:Class="NightlyLauncher.Views.UserControls.AppBrowserView"
             x:DataType="vm:AppBrowserViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource PageRowSpacing}">
        <Grid Margin="{StaticResource PageHeaderMargin}"
              ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}"
                       Theme="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />

            <ui:FACommandBar Grid.Column="1"
                             DefaultLabelPosition="Right"
                             VerticalAlignment="Center">
                <ui:FACommandBar.PrimaryCommands>
                    <ui:FACommandBarButton Label="{loc:T AddAppLabel}"
                                           Command="{Binding AddAppCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Add" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>
                </ui:FACommandBar.PrimaryCommands>
            </ui:FACommandBar>
        </Grid>

        <TextBox Grid.Row="1"
                 Margin="{StaticResource PageContentMargin}"
                 PlaceholderText="{loc:T SearchPlaceholderText}"
                 Text="{Binding SearchText}" />

        <ListBox Grid.Row="2"
                 Padding="{StaticResource PageScrollPadding}"
                 DoubleTapped="AppListBox_DoubleTapped"
                 ItemsSource="{Binding FilteredApps}"
                 SelectedItem="{Binding SelectedManifest}"
                 x:Name="AppListBox">
            <ListBox.KeyBindings>
                <KeyBinding Command="{Binding AddAppCommand}"
                            Gesture="Enter" />
            </ListBox.KeyBindings>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="ContextFlyout">
                        <ui:FAMenuFlyout>
                            <ui:FAMenuFlyoutItem Text="{loc:T AddAppLabel}"
                                                 Command="{Binding #AppListBox.((vm:AppBrowserViewModel)DataContext)?.AddAppCommand}" />
                        </ui:FAMenuFlyout>
                    </Setter>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0 8"
                                Orientation="Horizontal"
                                Spacing="12">
                        <ic:SymbolIcon Symbol="AppGeneric"
                                       FontSize="{StaticResource ListItemIconSize}"
                                       VerticalAlignment="Center" />

                        <TextBlock Text="{Binding DisplayName}"
                                   ToolTip.Tip="{Binding Guid}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
