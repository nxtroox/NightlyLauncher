<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:Class="NightlyLauncher.Views.UserControls.AppBrowserView"
             x:DataType="vm:AppBrowserViewModel">
    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="8">
        <TextBox PlaceholderText="{Binding SearchPlaceholderText}"
                 Text="{Binding SearchText}" />

        <ListBox Grid.Row="1"
                 DoubleTapped="AppListBox_DoubleTapped"
                 ItemsSource="{Binding FilteredApps}"
                 SelectedItem="{Binding SelectedApp}"
                 x:Name="AppListBox">
            <ListBox.KeyBindings>
                <KeyBinding Command="{Binding AddAppCommand}"
                            Gesture="Enter" />
            </ListBox.KeyBindings>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="ContextFlyout">
                        <ui:FAMenuFlyout>
                            <ui:FAMenuFlyoutItem Text="Add"
                                                 Command="{Binding #AppListBox.((vm:AppBrowserViewModel)DataContext)?.AddAppCommand}" />
                        </ui:FAMenuFlyout>
                    </Setter>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
