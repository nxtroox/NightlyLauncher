<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:loc="clr-namespace:NightlyLauncher.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:Class="NightlyLauncher.Views.UserControls.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource PageRowSpacing}">
        <Grid Margin="{StaticResource PageHeaderMargin}"
              ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}"
                       Theme="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />

            <ui:FACommandBar Grid.Column="1"
                             DefaultLabelPosition="Right"
                             VerticalAlignment="Center">
                <ui:FACommandBar.PrimaryCommands>
                    <ui:FACommandBarButton Label="{loc:T SaveCommandBarButtonLabel}"
                                           Command="{Binding SaveCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Save" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>
                </ui:FACommandBar.PrimaryCommands>
                <ui:FACommandBar.SecondaryCommands>
                    <ui:FACommandBarButton Label="{loc:T IssuesCommandBarButtonLabel}"
                                           Command="{Binding OpenIssuesPageCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Bug" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>

                    <ui:FACommandBarButton Label="{loc:T SourceCodeCommandBarButtonLabel}"
                                           Command="{Binding OpenSourceCodePageCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Branch" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>

                    <ui:FACommandBarSeparator />

                    <ui:FACommandBarButton Label="{loc:T AboutCommandBarButtonLabel}"
                                           Command="{Binding OpenAboutDialogCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Info" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>
                </ui:FACommandBar.SecondaryCommands>
            </ui:FACommandBar>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageScrollPadding}">
            <StackPanel Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:T GeneralOptionsHeading}"
                               Theme="{StaticResource BodyStrongTextBlockStyle}" />

                    <ui:FASettingsExpander Header="{loc:T CloseAfterLaunchHeader}"
                                           Description="{loc:T CloseAfterLaunchDescription}">
                        <ui:FASettingsExpander.IconSource>
                            <ic:SymbolIconSource Symbol="ArrowExit" />
                        </ui:FASettingsExpander.IconSource>

                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding Config?.CloseAfterLaunch}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:T PathOptionsHeading}"
                               Theme="{StaticResource BodyStrongTextBlockStyle}" />

                    <StackPanel Spacing="4">
                        <ui:FASettingsExpander Header="{loc:T AppPathHeader}"
                                               IsExpanded="True">
                            <ui:FASettingsExpander.IconSource>
                                <ic:SymbolIconSource Symbol="Apps" />
                            </ui:FASettingsExpander.IconSource>

                            <ui:FASettingsExpander.Footer>
                                <Button Classes="icon-only"
                                        Command="{Binding OpenAppsFolderCommand}"
                                        ToolTip.Tip="{loc:T OpenFolderButtonTooltip}">
                                    <ic:SymbolIcon Symbol="OpenFolder" />
                                </Button>
                            </ui:FASettingsExpander.Footer>

                            <ui:FASettingsExpanderItem Content="{Binding Config?.AppPath}"
                                                       Description="{loc:T AppPathDescription}">
                                <ui:FASettingsExpanderItem.IconSource>
                                    <ic:SymbolIconSource Symbol="Folder" />
                                </ui:FASettingsExpanderItem.IconSource>
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="icon-only"
                                                Command="{Binding SelectAppPathCommand}"
                                                ToolTip.Tip="{loc:T SelectFolderButtonTooltip}">
                                            <ic:SymbolIcon Symbol="FolderSearch" />
                                        </Button>

                                        <Button Classes="icon-only"
                                                Command="{Binding ChangeAppPathCommand}"
                                                ToolTip.Tip="{loc:T EditPathButtonTooltip}">
                                            <ic:SymbolIcon Symbol="Edit" />
                                        </Button>
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="{loc:T CachePathHeader}"
                                               IsExpanded="True">
                            <ui:FASettingsExpander.IconSource>
                                <ic:SymbolIconSource Symbol="DatabaseLightning" />
                            </ui:FASettingsExpander.IconSource>

                            <ui:FASettingsExpander.Footer>
                                <Button Classes="icon-only"
                                        Command="{Binding OpenCacheFolderCommand}"
                                        ToolTip.Tip="{loc:T OpenFolderButtonTooltip}">
                                    <ic:SymbolIcon Symbol="OpenFolder" />
                                </Button>
                            </ui:FASettingsExpander.Footer>

                            <ui:FASettingsExpanderItem Content="{Binding Config?.CachePath}"
                                                       Description="{loc:T CachePathDescription}">
                                <ui:FASettingsExpanderItem.IconSource>
                                    <ic:SymbolIconSource Symbol="Folder" />
                                </ui:FASettingsExpanderItem.IconSource>
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="icon-only"
                                                Command="{Binding SelectCachePathCommand}"
                                                ToolTip.Tip="{loc:T SelectFolderButtonTooltip}">
                                            <ic:SymbolIcon Symbol="FolderSearch" />
                                        </Button>

                                        <Button Classes="icon-only"
                                                Command="{Binding ChangeCachePathCommand}"
                                                ToolTip.Tip="{loc:T EditPathButtonTooltip}">
                                            <ic:SymbolIcon Symbol="Edit" />
                                        </Button>
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
