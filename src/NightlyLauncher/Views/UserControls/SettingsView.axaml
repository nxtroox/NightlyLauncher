<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:Class="NightlyLauncher.Views.UserControls.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <StackPanel Spacing="8">
            <StackPanel Spacing="4">
                <TextBlock Text="App path" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding Config?.AppPath}" />
                    <Button Grid.Column="1"
                            Content="Select folder"
                            Command="{Binding SelectAppPathCommand}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Download path" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding Config?.DownloadPath}" />
                    <Button Grid.Column="1"
                            Content="Select folder"
                            Command="{Binding SelectDownloadPathCommand}" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="1" Content="Save"
                HorizontalAlignment="Right"
                Command="{Binding SaveCommand}" />
    </Grid>
</UserControl>
