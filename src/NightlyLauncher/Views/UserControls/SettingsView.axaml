<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:Class="NightlyLauncher.Views.UserControls.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <ui:FACommandBar Grid.Column="1" DefaultLabelPosition="Right">
                <ui:FACommandBar.PrimaryCommands>
                    <ui:FACommandBarButton Label="Save"
                                           Command="{Binding SaveCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Save" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>
                </ui:FACommandBar.PrimaryCommands>
            </ui:FACommandBar>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="App path" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding Config?.AppPath}" />
                        <Button Grid.Column="1"
                                Content="Select folder"
                                Command="{Binding SelectAppPathCommand}" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Download path" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding Config?.DownloadPath}" />
                        <Button Grid.Column="1"
                                Content="Select folder"
                                Command="{Binding SelectDownloadPathCommand}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
