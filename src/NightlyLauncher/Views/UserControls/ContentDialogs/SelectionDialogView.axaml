<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:NightlyLauncher.Core.Models;assembly=NightlyLauncher.Core"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             x:Class="NightlyLauncher.Views.UserControls.ContentDialogs.SelectionDialogView"
             x:DataType="vm:SelectionViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="{Binding Content}" />

        <ui:FAComboBox HorizontalAlignment="Stretch"
                       ItemsSource="{Binding Items}"
                       SelectedItem="{Binding SelectedItem}">
            <ui:FAComboBox.ItemTemplate>
                <DataTemplate DataType="models:InstallOption">
                    <TextBlock Text="{Binding DisplayName}"
                               ToolTip.Tip="{Binding Guid}" />
                </DataTemplate>
            </ui:FAComboBox.ItemTemplate>
        </ui:FAComboBox>
    </StackPanel>
</UserControl>
