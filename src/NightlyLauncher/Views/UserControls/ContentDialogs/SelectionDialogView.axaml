<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:NightlyLauncher.Models"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             x:Class="NightlyLauncher.Views.UserControls.ContentDialogs.SelectionDialogView"
             x:DataType="vm:SelectionViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="{Binding Content}" />

        <ComboBox ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:InstallOption}">
                    <TextBlock Text="{Binding DisplayName}"
                               ToolTip.Tip="{Binding Guid}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </StackPanel>
</UserControl>
