<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:conv="clr-namespace:NightlyLauncher.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:NightlyLauncher.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:NightlyLauncher.Models"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             x:Class="NightlyLauncher.Views.UserControls.ContentDialogs.EditDialogView"
             x:DataType="vm:EditDialogViewModel">
    <ScrollViewer>
        <StackPanel Spacing="8">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:T SelectedInstallOptionHeading}" />
                <ui:FAComboBox ItemsSource="{Binding SelectedApp?.Manifest.InstallOptions}"
                               SelectedItem="{Binding SelectedInstallOption, Mode=TwoWay}"
                               PlaceholderText="{loc:T SelectedInstallOptionComboboxPlaceholderText}"
                               IsEnabled="{Binding SelectedApp?.Manifest.InstallOptions.Count, Converter={x:Static conv:CollectionConverters.HasMultipleItems}}">
                    <ui:FAComboBox.ItemTemplate>
                        <DataTemplate DataType="models:InstallOption">
                            <TextBlock Text="{Binding DisplayName}"
                                       ToolTip.Tip="{Binding Guid}" />
                        </DataTemplate>
                    </ui:FAComboBox.ItemTemplate>
                </ui:FAComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
                <CheckBox IsChecked="{Binding SelectedApp?.Manifest.UpdatePrompt}"
                          Content="{loc:T UpdatePromptLabel}" />
                <CheckBox IsChecked="{Binding SelectedApp?.Manifest.Portable}"
                          Content="{loc:T PortableLabel}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
