<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:conv="clr-namespace:NightlyLauncher.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:loc="clr-namespace:NightlyLauncher.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:NightlyLauncher.Core.Models;assembly=NightlyLauncher.Core"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             x:Class="NightlyLauncher.Views.UserControls.ContentDialogs.EditDialogView"
             x:DataType="vm:EditDialogViewModel">
    <ScrollViewer>
        <StackPanel Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:T AppOptionsHeading}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Spacing="4">
                    <ui:FASettingsExpander Header="{loc:T SelectedInstallOptionContent}"
                                           Description="{loc:T SelectedInstallOptionDescription}">
                        <ui:FASettingsExpander.IconSource>
                            <ic:SymbolIconSource Symbol="ArrowClockwise" />
                        </ui:FASettingsExpander.IconSource>

                        <ui:FASettingsExpander.Footer>
                            <ui:FAComboBox ItemsSource="{Binding SelectedApp?.Manifest.InstallOptions}"
                                           SelectedItem="{Binding SelectedInstallOption, Mode=TwoWay}"
                                           PlaceholderText="{loc:T SelectedInstallOptionComboBoxPlaceholderText}"
                                           IsEnabled="{Binding SelectedApp?.Manifest.InstallOptions.Count, Converter={x:Static conv:CollectionConverters.HasMultipleItems}}">
                                <ui:FAComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:InstallOption">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   ToolTip.Tip="{Binding Guid}" />
                                    </DataTemplate>
                                </ui:FAComboBox.ItemTemplate>
                            </ui:FAComboBox>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>

                    <ui:FASettingsExpander Header="{loc:T PortableContent}"
                                           Description="{loc:T PortableDescription}">
                        <ui:FASettingsExpander.IconSource>
                            <ic:SymbolIconSource Symbol="Folder" />
                        </ui:FASettingsExpander.IconSource>

                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding SelectedApp?.Options.Portable}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{loc:T LaunchOptionsHeading}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Spacing="4">
                    <ui:FASettingsExpander Header="{loc:T UpdatePromptContent}"
                                           Description="{loc:T UpdatePromptDescription}">
                        <ui:FASettingsExpander.IconSource>
                            <ic:SymbolIconSource Symbol="Window" />
                        </ui:FASettingsExpander.IconSource>

                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding SelectedApp?.Options.UpdatePrompt}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
