<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:NightlyLauncher.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             x:Class="NightlyLauncher.Views.UserControls.ContentDialogs.AboutDialogView"
             x:DataType="vm:AboutDialogViewModel">
    <StackPanel Spacing="24">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Image Source="/Assets/NightlyLauncher.ico"
                   Width="32"
                   Height="32"
                   VerticalAlignment="Center" />

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding AppName}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:T By}"
                               VerticalAlignment="Center"
                               FontWeight="Light" />

                    <HyperlinkButton Content="{loc:T AuthorName}"
                                     NavigateUri="{Binding AuthorUri}"
                                     VerticalAlignment="Center"
                                     FontWeight="Light"
                                     Padding="0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="{loc:T LibrariesHeading}"
                       Theme="{StaticResource BodyStrongTextBlockStyle}" />

            <ItemsControl ItemsSource="{Binding Libraries}"
                          x:Name="LibraryItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <HyperlinkButton Content="{Binding}"
                                         Command="{Binding #LibraryItemsControl.((vm:AboutDialogViewModel)DataContext)?.OpenLibraryCommand}"
                                         CommandParameter="{Binding}"
                                         FontWeight="Light"
                                         Padding="0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
