<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:cnv="clr-namespace:NightlyLauncher.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:loc="clr-namespace:NightlyLauncher.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:Class="NightlyLauncher.Views.UserControls.LibraryView"
             x:DataType="vm:LibraryViewModel">
    <UserControl.Resources>
        <cnv:SubstringConverter x:Key="SubstringConverter" />
        <cnv:StringToBitmapConverter x:Key="StringToBitmapConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <ui:FACommandBar Grid.Column="1"
                             DefaultLabelPosition="Right">
                <ui:FACommandBar.PrimaryCommands>
                    <ui:FACommandBarButton Label="{loc:T UpdateRepositoriesCommandBarButtonLabel}"
                                           Command="{Binding UpdateRepositoriesCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="ArrowClockwise" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>
                </ui:FACommandBar.PrimaryCommands>
                <ui:FACommandBar.SecondaryCommands>
                    <ui:FACommandBarButton Label="{loc:T OpenAppsFolderCommandBarButtonLabel}"
                                           Command="{Binding OpenAppsFolderCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Folder" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>

                    <ui:FACommandBarSeparator />

                    <ui:FACommandBarButton Label="{loc:T ExitCommandBarButtonLabel}"
                                           Command="{Binding ExitCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="ArrowExit" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>
                </ui:FACommandBar.SecondaryCommands>
            </ui:FACommandBar>
        </Grid>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Apps}"
                 SelectedItem="{Binding SelectedApp}"
                 DoubleTapped="AppListBox_DoubleTapped"
                 x:Name="AppListBox">
            <ListBox.KeyBindings>
                <KeyBinding Command="{Binding LaunchAppCommand}"
                            Gesture="Enter" />
            </ListBox.KeyBindings>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="ContextFlyout">
                        <ui:FAMenuFlyout>
                            <ui:FAMenuFlyoutItem Text="{loc:T LaunchAppLabel}"
                                                 Command="{Binding #AppListBox.((vm:LibraryViewModel)DataContext)?.LaunchAppCommand}">
                                <ui:FAMenuFlyoutItem.IconSource>
                                    <ic:SymbolIconSource Symbol="Play" />
                                </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>

                            <ui:FAMenuFlyoutSeparator />

                            <ui:FAMenuFlyoutItem Text="{loc:T EditAppLabel}"
                                                 Command="{Binding #AppListBox.((vm:LibraryViewModel)DataContext)?.EditAppCommand}">
                                <ui:FAMenuFlyoutItem.IconSource>
                                    <ic:SymbolIconSource Symbol="Edit" />
                                </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>

                            <ui:FAMenuFlyoutItem Text="{loc:T OpenAppFolderLabel}"
                                                 Command="{Binding #AppListBox.((vm:LibraryViewModel)DataContext)?.OpenAppFolderCommand}">
                                <ui:FAMenuFlyoutItem.IconSource>
                                    <ic:SymbolIconSource Symbol="Folder" />
                                </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>

                            <ui:FAMenuFlyoutSeparator />

                            <ui:FAMenuFlyoutItem Text="{loc:T RemoveAppLabel}"
                                                 Command="{Binding #AppListBox.((vm:LibraryViewModel)DataContext)?.RemoveAppCommand}">
                                <ui:FAMenuFlyoutItem.IconSource>
                                    <ic:SymbolIconSource Symbol="Delete" />
                                </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>
                        </ui:FAMenuFlyout>
                    </Setter>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="AppGeneric"
                                           IsVisible="{Binding IconPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />

                            <Image Source="{Binding IconPath, Converter={StaticResource StringToBitmapConverter}}"
                                   IsVisible="{Binding IconPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   MaxHeight="24" />

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding App.Manifest.DisplayName}" />
                                <TextBlock
                                    Text="{Binding App.LocalVersion, Converter={StaticResource SubstringConverter}, ConverterParameter=7}"
                                    IsVisible="{Binding App.LocalVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    FontWeight="Light"
                                    FontSize="10" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding App.LastUpdatedOn, StringFormat='{}{0:d}'}"
                                   IsVisible="{Binding App.LastUpdatedOn, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   ToolTip.Tip="{Binding App.LastUpdatedOn, StringFormat='{}{0:t}'}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
