<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:Class="NightlyLauncher.Views.UserControls.LibraryView"
             x:DataType="vm:LibraryViewModel">
    <Grid Margin="16" RowDefinitions="Auto,*" RowSpacing="8">
        <ui:FACommandBar DefaultLabelPosition="Right">
            <ui:FACommandBar.PrimaryCommands>
                <ui:FACommandBarButton Label="Update repositories"
                                       Command="{Binding UpdateRepositoriesCommand}">
                    <ui:FACommandBarButton.IconSource>
                        <ic:SymbolIconSource Symbol="ArrowClockwise" />
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>

                <ui:FACommandBarSeparator />

                <ui:FACommandBarButton Label="Edit"
                                       Command="{Binding EditAppCommand}">
                    <ui:FACommandBarButton.IconSource>
                        <ic:SymbolIconSource Symbol="Edit" />
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>

                <ui:FACommandBarButton Label="Open folder"
                                       Command="{Binding OpenAppFolderCommand}">
                    <ui:FACommandBarButton.IconSource>
                        <ic:SymbolIconSource Symbol="Folder" />
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>

                <ui:FACommandBarButton Label="Remove"
                                       Command="{Binding RemoveAppCommand}">
                    <ui:FACommandBarButton.IconSource>
                        <ic:SymbolIconSource Symbol="Delete" />
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>
            </ui:FACommandBar.PrimaryCommands>
            <ui:FACommandBar.SecondaryCommands>
                <ui:FACommandBarButton Label="Open Apps folder"
                                       Command="{Binding OpenAppsFolderCommand}">
                    <ui:FACommandBarButton.IconSource>
                        <ic:SymbolIconSource Symbol="Folder" />
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>

                <ui:FACommandBarButton Label="Open Downloads folder"
                                       Command="{Binding OpenDownloadsFolderCommand}">
                    <ui:FACommandBarButton.IconSource>
                        <ic:SymbolIconSource Symbol="Folder" />
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>

                <ui:FACommandBarSeparator />

                <ui:FACommandBarButton Label="Exit"
                                       Command="{Binding ExitCommand}">
                    <ui:FACommandBarButton.IconSource>
                        <ic:SymbolIconSource Symbol="ArrowExit" />
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>
            </ui:FACommandBar.SecondaryCommands>
        </ui:FACommandBar>


        <ScrollViewer Grid.Row="1">
            <ListBox DoubleTapped="AppListBox_DoubleTapped"
                     ItemsSource="{Binding Apps}"
                     SelectedItem="{Binding SelectedApp}"
                     x:Name="AppListBox">
                <ListBox.KeyBindings>
                    <KeyBinding Command="{Binding LaunchAppCommand}"
                                Gesture="Enter" />
                </ListBox.KeyBindings>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="ContextFlyout">
                            <ui:FAMenuFlyout>
                                <ui:FAMenuFlyoutItem Text="Launch"
                                                     Command="{Binding #AppListBox.((vm:LibraryViewModel)DataContext)?.LaunchAppCommand}">
                                    <ui:FAMenuFlyoutItem.IconSource>
                                        <ic:SymbolIconSource Symbol="Play" />
                                    </ui:FAMenuFlyoutItem.IconSource>
                                </ui:FAMenuFlyoutItem>

                                <ui:FAMenuFlyoutSeparator />

                                <ui:FAMenuFlyoutItem Text="Edit"
                                                     Command="{Binding #AppListBox.((vm:LibraryViewModel)DataContext)?.EditAppCommand}">
                                    <ui:FAMenuFlyoutItem.IconSource>
                                        <ic:SymbolIconSource Symbol="Edit" />
                                    </ui:FAMenuFlyoutItem.IconSource>
                                </ui:FAMenuFlyoutItem>

                                <ui:FAMenuFlyoutItem Text="Open folder"
                                                     Command="{Binding #AppListBox.((vm:LibraryViewModel)DataContext)?.OpenAppFolderCommand}">
                                    <ui:FAMenuFlyoutItem.IconSource>
                                        <ic:SymbolIconSource Symbol="Folder" />
                                    </ui:FAMenuFlyoutItem.IconSource>
                                </ui:FAMenuFlyoutItem>

                                <ui:FAMenuFlyoutSeparator />

                                <ui:FAMenuFlyoutItem Text="Remove"
                                                     Command="{Binding #AppListBox.((vm:LibraryViewModel)DataContext)?.RemoveAppCommand}">
                                    <ui:FAMenuFlyoutItem.IconSource>
                                        <ic:SymbolIconSource Symbol="Delete" />
                                    </ui:FAMenuFlyoutItem.IconSource>
                                </ui:FAMenuFlyoutItem>
                            </ui:FAMenuFlyout>
                        </Setter>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Manifest.DisplayName}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LastUpdatedOn, StringFormat='{}{0:d}', TargetNullValue='Not installed'}"
                                       ToolTip.Tip="{Binding LastUpdatedOn, StringFormat='{}{0:t}', TargetNullValue='Never updated'}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
