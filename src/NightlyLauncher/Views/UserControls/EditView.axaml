<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:Class="NightlyLauncher.Views.UserControls.EditView"
             x:DataType="vm:EditViewModel">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollViewer>
            <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding SelectedApp?.Manifest.DisplayName}"
                               ToolTip.Tip="{Binding SelectedApp?.Manifest.Guid}" />
                    <TextBlock FontSize="10"
                               Text="{Binding SelectedApp?.LastUpdatedOn, StringFormat='{}Last updated {0:D}', TargetNullValue='Not installed'}"
                               ToolTip.Tip="{Binding SelectedApp?.LastUpdatedOn, StringFormat='{}{0:T}', TargetNullValue='Never updated'}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Selected install option:" />
                    <ComboBox ItemsSource="{Binding SelectedApp?.Manifest.InstallOptions}"
                              SelectedItem="{Binding SelectedInstallOption, Mode=TwoWay}"
                              PlaceholderText="Select an installation option">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           ToolTip.Tip="{Binding Guid}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <CheckBox IsChecked="{Binding SelectedApp?.Manifest.UpdatePrompt}"
                              Content="Prompt on update" />
                    <CheckBox IsChecked="{Binding SelectedApp?.Manifest.Portable}"
                              Content="Portable mode" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="4">
            <Button Content="Save"
                    HorizontalAlignment="Right"
                    Command="{Binding OkCommand}" />
            <Button Content="Cancel"
                    HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
