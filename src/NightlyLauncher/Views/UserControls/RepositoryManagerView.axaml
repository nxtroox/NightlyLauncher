<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:loc="clr-namespace:NightlyLauncher.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:Class="NightlyLauncher.Views.UserControls.RepositoryManagerView"
             x:DataType="vm:RepositoryManagerViewModel">
    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <ui:FACommandBar Grid.Column="1" DefaultLabelPosition="Right">
                <ui:FACommandBar.PrimaryCommands>
                    <ui:FACommandBarButton Label="{loc:T AddRepositoryCommandBarButtonLabel}"
                                           Command="{Binding AddRepositoryCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Add" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>
                </ui:FACommandBar.PrimaryCommands>
                <ui:FACommandBar.SecondaryCommands>
                    <ui:FACommandBarButton Label="{loc:T OpenRepositoryLabel}"
                                           Command="{Binding OpenRepositoryCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Globe" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>

                    <ui:FACommandBarSeparator />

                    <ui:FACommandBarButton Label="{loc:T RemoveRepositoryLabel}"
                                           Command="{Binding RemoveRepositoryCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Delete" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>
                </ui:FACommandBar.SecondaryCommands>
            </ui:FACommandBar>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Repositories}"
                 SelectedItem="{Binding SelectedRepository}"
                 DoubleTapped="RepositoryListBox_DoubleTapped"
                 x:Name="RepositoryListBox">
            <ListBox.KeyBindings>
                <KeyBinding Command="{Binding OpenRepositoryCommand}"
                            Gesture="Enter" />
            </ListBox.KeyBindings>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Database" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       ToolTip.Tip="{Binding UpdateUri}" />
                            <TextBlock Text="{Binding Guid}"
                                       FontWeight="Light"
                                       FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="ContextFlyout">
                        <ui:FAMenuFlyout>
                            <ui:FAMenuFlyoutItem Text="{loc:T OpenRepositoryLabel}"
                                                 Command="{Binding #RepositoryListBox.((vm:RepositoryManagerViewModel)DataContext)?.OpenRepositoryCommand}">
                                <ui:FAMenuFlyoutItem.IconSource>
                                    <ic:SymbolIconSource Symbol="Globe" />
                                </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>

                            <ui:FAMenuFlyoutSeparator />

                            <ui:FAMenuFlyoutItem Text="{loc:T RemoveRepositoryLabel}"
                                                 Command="{Binding #RepositoryListBox.((vm:RepositoryManagerViewModel)DataContext)?.RemoveRepositoryCommand}">
                                <ui:FAMenuFlyoutItem.IconSource>
                                    <ic:SymbolIconSource Symbol="Delete" />
                                </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>
                        </ui:FAMenuFlyout>
                    </Setter>
                </Style>
            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>
