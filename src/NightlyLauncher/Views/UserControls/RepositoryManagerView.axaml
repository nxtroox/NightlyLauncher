<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:Class="NightlyLauncher.Views.UserControls.RepositoryManagerView"
             x:DataType="vm:RepositoryManagerViewModel">
    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <ui:FACommandBar Grid.Column="1" DefaultLabelPosition="Right">
                <ui:FACommandBar.PrimaryCommands>
                    <ui:FACommandBarButton Label="Add repository"
                                           Command="{Binding AddRepositoryCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Add" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>

                    <ui:FACommandBarSeparator />

                    <ui:FACommandBarButton Label="Remove"
                                           Command="{Binding RemoveRepositoryCommand}">
                        <ui:FACommandBarButton.IconSource>
                            <ic:SymbolIconSource Symbol="Delete" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>
                </ui:FACommandBar.PrimaryCommands>
            </ui:FACommandBar>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Config?.Repositories}"
                 SelectedItem="{Binding SelectedRepository}"
                 x:Name="RepositoryListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}"
                               ToolTip.Tip="{Binding UpdateUri}"
                               VerticalAlignment="Center" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="ContextFlyout">
                        <ui:FAMenuFlyout>
                            <ui:FAMenuFlyoutItem Text="Remove"
                                                 Command="{Binding #RepositoryListBox.((vm:RepositoryManagerViewModel)DataContext)?.RemoveRepositoryCommand}">
                                <ui:FAMenuFlyoutItem.IconSource>
                                    <ic:SymbolIconSource Symbol="Delete" />
                                </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>
                        </ui:FAMenuFlyout>
                    </Setter>
                </Style>
            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>
