<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NightlyLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="NightlyLauncher.Views.Windows.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding Title}"
        Height="450"
        Width="400">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <StackPanel Spacing="8">
            <StackPanel Spacing="4">
                <TextBlock Text="App path" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <TextBox Text="{Binding Config?.AppPath}" />
                    <Button Grid.Column="1"
                            Content="Select folder"
                            Command="{Binding SelectAppPathCommand}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Download path" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <TextBox Text="{Binding Config?.DownloadPath}" />
                    <Button Grid.Column="1"
                            Content="Select folder"
                            Command="{Binding SelectDownloadPathCommand}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Repositories" />

                <ScrollViewer>
                    <ListBox ItemsSource="{Binding Config?.Repositories}"
                             SelectedItem="{Binding SelectedRepository}"
                             x:Name="RepositoryListBox">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           ToolTip.Tip="{Binding UpdateUri}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="ContextMenu">
                                    <ContextMenu>
                                        <MenuItem Header="Remove"
                                                  Command="{Binding #RepositoryListBox.((vm:SettingsViewModel)DataContext)?.RemoveRepositoryCommand}" />
                                    </ContextMenu>
                                </Setter>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </ScrollViewer>

                <Button Content="Add repository"
                        Command="{Binding AddRepositoryCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="4">
            <Button Content="Save"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveCommand}" />
            <Button Content="Cancel"
                    HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
