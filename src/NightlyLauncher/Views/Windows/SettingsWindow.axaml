<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NightlyLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="NightlyLauncher.Views.Windows.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="NightlyLauncher - Settings"
        Height="450"
        Width="400">
    <Grid RowDefinitions="*,Auto">
        <StackPanel>
            <Label Content="App path" />
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding Config?.AppPath}" />
                <Button Content="Select folder"
                        Command="{Binding SelectAppPathCommand}" />
            </StackPanel>

            <Label Content="Download path" />
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding Config?.DownloadPath}" />
                <Button Content="Select folder"
                        Command="{Binding SelectDownloadPathCommand}" />
            </StackPanel>

            <Label Content="Repositories" />
            <ScrollViewer>
                <ListBox ItemsSource="{Binding Config?.Repositories}"
                         SelectedItem="{Binding SelectedRepository}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding ReadableName}"
                                     ToolTip.Tip="{Binding UpdateUri}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <Button Content="Add repository"
                    Command="{Binding AddRepositoryCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveCommand}" />
            <Button Content="Cancel"
                    HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
