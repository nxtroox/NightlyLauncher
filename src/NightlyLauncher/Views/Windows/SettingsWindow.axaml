<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NightlyLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="NightlyLauncher.Views.Windows.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="NightlyLauncher - Settings"
        Height="450"
        Width="600">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
            <StackPanel>
                <Label Content="App path" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Config?.AppPath}" />
                    <Button Content="Select folder"
                            Command="{Binding SelectFolderCommand}" />
                </StackPanel>

                <Label Content="Download path" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Config?.DownloadPath}" />
                    <Button Content="Select folder"
                            Command="{Binding SelectFolderCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveConfigCommand}" />
            <Button Content="Cancel"
                    HorizontalAlignment="Right"
                    Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
