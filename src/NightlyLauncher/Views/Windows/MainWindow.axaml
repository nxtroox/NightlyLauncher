<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NightlyLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ic="using:FluentIcons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
        x:Class="NightlyLauncher.Views.Windows.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Height="800"
        Width="600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Add apps"
                          Command="{Binding AddAppsCommand}">
                    <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="Add" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem Header="_Update repositories"
                          Command="{Binding UpdateRepositoriesCommand}">
                    <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="ArrowClockwise" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem Header="Open _Apps folder"
                          Command="{Binding OpenAppsFolderCommand}">
                    <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="Folder" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Open _Downloads folder"
                          Command="{Binding OpenDownloadsFolderCommand}">
                    <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="Folder" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}">
                    <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="ArrowExit" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Edit app"
                          Command="{Binding EditAppCommand}">
                    <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="Edit" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="_Remove app"
                          Command="{Binding RemoveAppCommand}">
                    <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="Delete" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem Header="_Settings"
                          Command="{Binding OpenSettingsCommand}">
                    <MenuItem.Icon>
                        <ic:SymbolIcon Symbol="Settings" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <ScrollViewer>
            <ListBox DoubleTapped="AppListBox_DoubleTapped"
                     ItemsSource="{Binding Apps}"
                     SelectedItem="{Binding SelectedApp}"
                     x:Name="AppListBox">
                <ListBox.KeyBindings>
                    <KeyBinding Command="{Binding LaunchAppCommand}"
                                Gesture="Enter" />
                </ListBox.KeyBindings>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="ContextMenu">
                            <ContextMenu>
                                <MenuItem Header="Launch"
                                          Command="{Binding #AppListBox.((vm:MainViewModel)DataContext)?.LaunchAppCommand}">
                                    <MenuItem.Icon>
                                        <ic:SymbolIcon Symbol="Play" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem Header="_Edit"
                                          Command="{Binding #AppListBox.((vm:MainViewModel)DataContext)?.EditAppCommand}">
                                    <MenuItem.Icon>
                                        <ic:SymbolIcon Symbol="Edit" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem Header="_Remove"
                                          Command="{Binding #AppListBox.((vm:MainViewModel)DataContext)?.RemoveAppCommand}">
                                    <MenuItem.Icon>
                                        <ic:SymbolIcon Symbol="Delete" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Setter>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Manifest.DisplayName}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LastUpdatedOn, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue='Not installed'}"
                                       ToolTip.Tip="{Binding LastUpdatedOn, StringFormat='{}{0:HH:mm}'}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </DockPanel>
</Window>
