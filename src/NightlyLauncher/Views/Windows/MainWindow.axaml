<wnd:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:NightlyLauncher.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:models="clr-namespace:NightlyLauncher.Models"
                 xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                 xmlns:wnd="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
                 xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
                 mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
                 x:Class="NightlyLauncher.Views.Windows.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Title="{Binding Title}"
                 Height="800"
                 Width="600">
    <ui:FANavigationView PaneDisplayMode="Left"
                         IsPaneOpen="False"
                         IsSettingsVisible="False"
                         Content="{Binding CurrentPage}"
                         MenuItemsSource="{Binding MenuItems}"
                         FooterMenuItemsSource="{Binding FooterItems}"
                         SelectedItem="{Binding SelectedItem}">
        <ui:FANavigationView.MenuItemTemplate>
            <DataTemplate x:DataType="models:NavigationItem">
                <ui:FANavigationViewItem Content="{Binding Label}">
                    <ui:FANavigationViewItem.IconSource>
                        <ic:SymbolIconSource Symbol="{Binding Symbol}" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
            </DataTemplate>
        </ui:FANavigationView.MenuItemTemplate>
    </ui:FANavigationView>
</wnd:FAAppWindow>
