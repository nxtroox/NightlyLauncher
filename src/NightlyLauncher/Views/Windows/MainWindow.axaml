<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NightlyLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
        x:Class="NightlyLauncher.Views.Windows.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Height="800"
        Width="600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Add apps"
                          Command="{Binding AddAppsCommand}" />
                <Separator />
                <MenuItem Header="_Update repositories"
                          Command="{Binding UpdateRepositoriesCommand}" />
                <Separator />
                <MenuItem Header="Open _Apps folder"
                          Command="{Binding OpenAppsFolderCommand}" />
                <MenuItem Header="Open _Downloads folder"
                          Command="{Binding OpenDownloadsFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Edit app"
                          Command="{Binding EditAppCommand}" />
                <MenuItem Header="_Remove app"
                          Command="{Binding RemoveAppCommand}" />
                <Separator />
                <MenuItem Header="_Settings"
                          Command="{Binding OpenSettingsCommand}" />
            </MenuItem>
        </Menu>

        <ScrollViewer>
            <ListBox DoubleTapped="AppListBox_DoubleTapped"
                     ItemsSource="{Binding Apps}"
                     SelectedItem="{Binding SelectedApp}"
                     x:Name="AppListBox">
                <ListBox.KeyBindings>
                    <KeyBinding Command="{Binding LaunchAppCommand}"
                                Gesture="Enter" />
                </ListBox.KeyBindings>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="ContextMenu">
                            <ContextMenu>
                                <MenuItem Header="Launch"
                                          Command="{Binding #AppListBox.((vm:MainViewModel)DataContext)?.LaunchAppCommand}" />
                                <MenuItem Header="Edit"
                                          Command="{Binding #AppListBox.((vm:MainViewModel)DataContext)?.EditAppCommand}" />
                                <MenuItem Header="Remove"
                                          Command="{Binding #AppListBox.((vm:MainViewModel)DataContext)?.RemoveAppCommand}" />
                            </ContextMenu>
                        </Setter>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Manifest.DisplayName}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LastUpdatedOn, StringFormat='{}{0:dd.MM.yyyy}', TargetNullValue='Not installed'}"
                                       ToolTip.Tip="{Binding LastUpdatedOn, StringFormat='{}{0:HH:mm}'}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </DockPanel>
</Window>
