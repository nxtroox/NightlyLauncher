<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NightlyLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="NightlyLauncher.Views.Windows.EditWindow"
        x:DataType="vm:EditViewModel"
        Title="{Binding Title}"
        Height="450"
        Width="400">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollViewer>
            <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding SelectedApp?.Manifest.DisplayName}"
                               ToolTip.Tip="{Binding SelectedApp?.Manifest.Guid}" />
                    <TextBlock FontSize="10"
                               Text="{Binding SelectedApp?.LastUpdatedOn, StringFormat='{}Last updated {0:yyyy-MM-dd}'}"
                               ToolTip.Tip="{Binding SelectedApp?.LastUpdatedOn, StringFormat='{}{0:HH:mm}'}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Selected install option:" />
                    <ComboBox ItemsSource="{Binding SelectedApp?.Manifest.InstallOptions}"
                              SelectedItem="{Binding SelectedInstallOption, Mode=TwoWay}"
                              PlaceholderText="Select an installation option">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           ToolTip.Tip="{Binding Guid}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <CheckBox IsChecked="{Binding SelectedApp?.Manifest.UpdatePrompt}"
                              Content="Prompt on update" />
                    <CheckBox IsChecked="{Binding SelectedApp?.Manifest.Portable}"
                              Content="Portable mode" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="4">
            <Button Content="Save"
                    HorizontalAlignment="Right"
                    Command="{Binding OkCommand}" />
            <Button Content="Cancel"
                    HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
