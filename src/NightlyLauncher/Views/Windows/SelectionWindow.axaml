<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NightlyLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:NightlyLauncher.Models"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="200"
        x:Class="NightlyLauncher.Views.Windows.SelectionWindow"
        x:DataType="vm:SelectionViewModel"
        Title="{Binding Title}"
        WindowStartupLocation="CenterScreen"
        Height="200"
        Width="600">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="{Binding Content}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" />

            <ComboBox HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:InstallOption}">
                        <TextBlock Text="{Binding DisplayName}"
                                   ToolTip.Tip="{Binding Guid}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="4">
            <Button Content="Ok"
                    Command="{Binding OkCommand}" />
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
